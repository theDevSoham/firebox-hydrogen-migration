# Credentials for `npm run shopify:setup` (scripts/shopify-setup.ts).
# Copy to .env.setup (git-ignored) and fill in. How to get them: docs/shopify-access.md
# Kept apart from .env so the setup app's secret never reaches the storefront's runtime.

# The store's permanent address (Settings → Domains), e.g. firebox-kolkata.myshopify.com
SHOPIFY_STORE=

# From your Dev Dashboard app's Settings page
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
